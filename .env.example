# Server Configuration
ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=10485760

# Optional Authentication (leave empty/unset to disable auth)
AUTH_TOKEN=

# LLM Provider Selection: gemini | openai_compat | mock
LLM_PROVIDER=mock

# Gemini Provider Settings
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
SYSTEM_PROMPT_MODE=prepend
THINKING_LEVEL=minimal

# OpenAI-Compatible / Local Provider Settings (Ollama, vLLM)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma-4-26b-a4b-it

# Default Model & Constraints
ALLOWED_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it,mock
MAX_MESSAGES=100
MAX_CHARS_PER_MESSAGE=20000
MAX_TOTAL_CHARS=120000
DEFAULT_MAX_OUTPUT_TOKENS=2048
UPSTREAM_TIMEOUT_SECONDS=45.0

# Model Context Protocol (MCP) Settings
MCP_ENABLED=false
MCP_CONFIG_PATH=mcp_servers.json
TOOL_TIMEOUT_SECONDS=15.0
MAX_TOOL_RESULT_CHARS=8000
MAX_TOOL_ITERATIONS=5
MCP_ALLOWED_TOOLS=
TOOL_CALL_MODE=native
SQLITE_DB_PATH=storage/local.db
SQLITE_ALLOW_WRITE=false
